FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/trippalette?charset=utf8mb4

# Aiven에서는 DATABASE_URL을 비우고 아래 값을 각각 입력할 수 있습니다.
# 비밀번호에 특수문자가 있어도 URL 인코딩할 필요가 없습니다.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# 로컬: instance/aiven-ca.pem / Render Secret File: /etc/secrets/aiven-ca.pem
MYSQL_SSL_CA=

# 토스페이먼츠 테스트 키만 입력합니다. live_ 키는 애플리케이션에서 거부합니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_PAYMENT_MODE=test
